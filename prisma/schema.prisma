generator client {
  provider = "prisma-client"
  output   = "../app/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model Bookmark {
  id            String    @id @default(cuid())
  userId        String    @default("default")
  tweetId       String    @unique
  text          String
  authorHandle  String
  authorName    String
  tweetCreatedAt DateTime?
  importedAt    DateTime  @default(now())
  rawJson       String    // full JSON stored as string
  semanticTags    String?   // JSON array of AI-generated searchable tags
  entities        String?   // JSON: {hashtags[], urls[], mentions[], tools[], tweetType}
  fetchedContent   String?   // JSON: {url -> fetched markdown text}
  contentFetchedAt DateTime?
  enrichedAt      DateTime? // when AI enrichment last ran — drives incremental processing
  enrichmentMeta  String?   // JSON: {sentiment, people[], companies[]} from batch enrichment
  source          String    @default("bookmark")  // "bookmark" | "like"
  mediaItems    MediaItem[]
  categories    BookmarkCategory[]
  bookmarkRepos BookmarkRepo[]
  reviewSchedule ReviewSchedule?

  @@index([authorHandle])
  @@index([tweetCreatedAt])
  @@index([enrichedAt])
  @@index([source])
}

model Category {
  id          String   @id @default(cuid())
  userId      String   @default("default")
  name        String   @unique
  slug        String   @unique
  color       String   @default("#6366f1")
  description String?
  isAiGenerated Boolean @default(false)
  createdAt   DateTime @default(now())
  bookmarks   BookmarkCategory[]
}

model BookmarkCategory {
  bookmarkId  String
  categoryId  String
  confidence  Float    @default(1.0)
  bookmark    Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  category    Category @relation(fields: [categoryId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, categoryId])
}

model MediaItem {
  id           String   @id @default(cuid())
  userId       String   @default("default")
  bookmarkId   String
  type         String   // photo | video | gif
  url          String
  thumbnailUrl String?
  localPath    String?
  imageTags    String?  // AI-generated structured JSON visual description
  bookmark     Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@index([bookmarkId])
  @@index([url])
}

model ImportJob {
  id             String   @id @default(cuid())
  userId         String   @default("default")
  filename       String
  status         String   @default("pending") // pending | processing | done | error
  totalCount     Int      @default(0)
  processedCount Int      @default(0)
  errorMessage   String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model Setting {
  key   String @id
  value String
  userId String @default("default")
}

model Repo {
  id              String   @id @default(cuid())
  userId          String   @default("default")
  owner           String
  name            String
  fullName        String   @unique
  description     String?
  url             String
  stars           Int      @default(0)
  language        String?
  topics          String   @default("[]")   // JSON array
  readmeContent   String?                    // Raw README (truncated to 50k chars)
  features        String?                    // AI-extracted JSON (English)
  useCases        String?                    // AI-extracted JSON
  techStack       String?                    // AI-extracted JSON array
  summary         String?                    // AI-generated 1-2 sentence summary (English)
  featuresZh     String?                    // Chinese translation of features
  useCasesZh      String?                    // Chinese translation of use cases
  summaryZh       String?                    // Chinese translation of summary
  readmeAnalyzedAt DateTime?
  importedAt      DateTime @default(now())
  bookmarkRepos   BookmarkRepo[]

  @@index([fullName])
  @@index([owner])
  @@index([stars])
}

model BookmarkRepo {
  bookmarkId  String
  repoId     String
  bookmark   Bookmark @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)
  repo       Repo    @relation(fields: [repoId], references: [id], onDelete: Cascade)

  @@id([bookmarkId, repoId])
  @@index([repoId])
}

model RecommendedRepo {
  id          String   @id @default(cuid())
  userId      String   @default("default")
  fullName    String
  description String?
  stars       Int      @default(0)
  forks       Int      @default(0)
  language    String?
  topics      String   @default("[]")
  url         String
  mode        String   // "similar" | "trending" | "by-language"
  added       Boolean  @default(false)
  savedAt     DateTime @default(now())

  @@unique([fullName, mode])
  @@index([fullName])
  @@index([savedAt])
  @@index([mode])
}

model ReviewSchedule {
  id           String    @id @default(cuid())
  userId       String    @default("default")
  bookmarkId   String    @unique
  interval     Int       @default(1)      // days until next review
  easeFactor   Float     @default(2.5)    // SM-2 ease factor (min 1.3)
  repetitions  Int       @default(0)       // number of successful reviews
  nextReviewAt DateTime
  lastReviewAt DateTime?
  createdAt    DateTime  @default(now())
  bookmark     Bookmark  @relation(fields: [bookmarkId], references: [id], onDelete: Cascade)

  @@index([nextReviewAt])
  @@index([bookmarkId])
}
